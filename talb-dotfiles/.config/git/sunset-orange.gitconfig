# Sunset Orange git colours. Part of talb-dotfiles.
# Included from ~/.config/git/config via:  [include] path = ~/.config/git/sunset-orange.gitconfig
[color]
	ui = auto
[color "diff"]
	meta = 214 bold
	frag = 208 bold
	func = 223
	commit = 220
	context = 250
	old = 196
	new = 220
	oldMoved = 160 italic
	newMoved = 221 italic
	whitespace = 196 reverse
[color "diff-highlight"]
	oldNormal = 196
	oldHighlight = 255 160 bold
	newNormal = 220
	newHighlight = 234 220 bold
[color "status"]
	header = 244
	added = 220
	updated = 220
	changed = 202
	untracked = 208
	branch = 208 bold
	localBranch = 208 bold
	remoteBranch = 214
	nobranch = 196 bold
	unmerged = 196 bold
[color "branch"]
	current = 208 bold
	local = 223
	remote = 214
	upstream = 221
	plain = 250
[color "decorate"]
	HEAD = 208 bold
	branch = 220 bold
	remoteBranch = 214
	tag = 220 bold
	stash = 209
	grafted = 166
[color "grep"]
	filename = 208
	lineNumber = 244
	column = 244
	separator = 242
	function = 223
	match = 234 214 bold
[color "interactive"]
	prompt = 208 bold
	header = 214
	help = 244
	error = 196 bold
